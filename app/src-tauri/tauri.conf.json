{
  "$schema": "https://schema.tauri.app/config/2.0",
  "productName": "reading-tracker",
  "version": "0.1.0",
  "identifier": "com.reading-tracker.dev",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Reading Tracker",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "main-capability",
          "description": "Main application capabilities",
          "windows": ["main"],
          "permissions": [
            "sql:allow-load",
            "sql:allow-execute",
            "sql:allow-select",
            "sql:default",
            "core:event:default",
            "core:event:allow-listen",
            "core:event:allow-emit",
            "dialog:allow-ask"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:reading_tracker.db", "sqlite:reading_tracker_dev.db"]
    }
  }
}
